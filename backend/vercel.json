{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "FIREBASE_CREDENTIALS": "@FIREBASE_CREDENTIALS",
    "JWT_SECRET_KEY": "@JWT_SECRET_KEY",
    "ENVIRONMENT": "production"
  }
}
