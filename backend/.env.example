# Backend environment variables
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Google Drive Configuration (for Exit & Experience Letters)
# Follow GOOGLE_DRIVE_SETUP.md for detailed setup instructions
# 1. Create Google Cloud project and enable Drive API
# 2. Create service account and download JSON key
# 3. Place key file in backend/credentials/service-account.json
# 4. (Optional) Create Drive folder and share with service account email
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=  # Optional: Folder ID for organizing letters

# Zoho SMTP Configuration
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_EMAIL=your-email@zoho.com
ZOHO_PASSWORD=your-zoho-password

# Upstash Redis (for caching - required on Vercel)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Supabase Configuration (PostgreSQL backend database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password