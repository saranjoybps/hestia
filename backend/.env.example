# Backend environment variables
FIREBASE_CREDENTIALS_PATH=credentials/firebase-credentials.json
# Production: set FIREBASE_CREDENTIALS to the complete Firebase Admin service-account JSON.
# Keep the JSON as a single-line environment variable value; never commit the real key.
FIREBASE_CREDENTIALS=
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Google Drive uses FIREBASE_CREDENTIALS; enable Drive API for hestia-c1483
# and share the target folder with that service account email.
GOOGLE_DRIVE_FOLDER_ID=  # Optional: Folder ID for organizing letters

# Zoho SMTP Configuration
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=587
ZOHO_EMAIL=your-email@zoho.com
ZOHO_PASSWORD=your-zoho-password

# Upstash Redis (for caching - required on Vercel)
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Supabase Configuration (PostgreSQL backend database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
