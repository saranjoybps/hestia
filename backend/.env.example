# Backend environment variables
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# Google Drive Configuration (for Exit & Experience Letters)
# Follow GOOGLE_DRIVE_SETUP.md for detailed setup instructions
# 1. Create Google Cloud project and enable Drive API
# 2. Create service account and download JSON key
# 3. Place key file in backend/credentials/service-account.json
# 4. (Optional) Create Drive folder and share with service account email
GOOGLE_SERVICE_ACCOUNT_PATH=credentials/service-account.json
GOOGLE_DRIVE_FOLDER_ID=  # Optional: Folder ID for organizing letters
